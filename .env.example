# =============================================================================
# OpsFlow AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Application
APP_NAME=OpsFlow AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite for local; switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./data/opsflow.db
# DATABASE_URL=postgresql+psycopg://opsflow:opsflow@localhost:5432/opsflow

# OpenAI (optional — offline heuristics work without a key)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2048

# Embeddings / Vector Store
# memory = lightweight offline demo | chroma = production RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE=memory
CHROMA_PERSIST_DIR=./data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5
RAG_SCORE_THRESHOLD=0.25

# File uploads
UPLOAD_DIR=./documents
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt

# Authentication (change defaults before any real deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=opsflow-admin-change-me
ADMIN_EMAIL=admin@opsflow.ai
# Local demos only — set false in production (requires JWT on every request)
DEMO_AUTH_BYPASS=true

# n8n Automation (false for quiet local demos)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_ENABLED=false
N8N_TASK_CREATED_WEBHOOK=task-created
N8N_DOCUMENT_UPLOADED_WEBHOOK=document-uploaded
N8N_MEETING_SUMMARY_WEBHOOK=meeting-summary
N8N_EMPLOYEE_ONBOARDING_WEBHOOK=employee-onboarding

# Analytics defaults (estimated minutes saved)
AVG_MINUTES_SAVED_PER_QUERY=8
AVG_MINUTES_SAVED_PER_TASK=15

# CORS
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Frontend
BACKEND_API_URL=http://localhost:8000
