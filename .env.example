# OpsFlow AI — Environment Configuration
# Copy to .env — NEVER commit real secrets.

# Application
APP_NAME=OpsFlow AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public portfolio demo (sample data + simulated n8n)
DEMO_MODE=true
DEMO_DATA_DIR=./demo_data

# Database
DATABASE_URL=sqlite:///./data/opsflow.db
# DATABASE_URL=postgresql+psycopg://opsflow:opsflow@localhost:5432/opsflow

# OpenAI (optional in demo — offline heuristics still work)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2048

# Vector store: memory (lightweight demo) | chroma (full RAG)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE=memory
CHROMA_PERSIST_DIR=./data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5
RAG_SCORE_THRESHOLD=0.25

# Uploads
UPLOAD_DIR=./documents
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt

# Auth — change before any public deploy
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-demo-password
ADMIN_EMAIL=admin@opsflow.ai
DEMO_AUTH_BYPASS=true

# n8n — keep false for public demo (workflows are simulated)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_ENABLED=false
N8N_TASK_CREATED_WEBHOOK=task-created
N8N_DOCUMENT_UPLOADED_WEBHOOK=document-uploaded
N8N_MEETING_SUMMARY_WEBHOOK=meeting-summary
N8N_EMPLOYEE_ONBOARDING_WEBHOOK=employee-onboarding

AVG_MINUTES_SAVED_PER_QUERY=8
AVG_MINUTES_SAVED_PER_TASK=15

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
BACKEND_API_URL=http://localhost:8000
